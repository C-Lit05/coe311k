    "## asked chatgpt \"what import statements are useful for approximating pi with the montecarlo method\"\n",
    "import math\n",
    "import random\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "def montecarlo(sample_num):\n",
    "    in_circ = 0\n",
    "    for _ in range(sample_num):\n",
    "        x = random.uniform(0,1)\n",
    "        y = random.uniform(0,1)\n",
    "        if x**2 + y**2 <= 1:\n",
    "            in_circ += 1\n",
    "            \n",
    "    return in_circ * 4 / sample_num\n",
    "## done with setting up the montecarlo and now setting up pi for the both approximation and the error calculation\n",
    "realpi = round(math.pi, 15)\n",
    "sample_sizes = list(range(10,1001,20))\n",
    "errors = []\n",
    "## was not aware you could use a variable as a range in a for loop\n",
    "for n in sample_sizes:\n",
    "    pi_est = montecarlo(n)\n",
    "    error = abs(pi_est - realpi)\n",
    "    errors.append(error)\n",
    "## still not completely certain what .append is doing. I also do not understand using the plural errors\n",
    "## checked my solution against a chatgpt solution and saw that was missing\n",
    "    \n",
    "for i in range(5): ## just going to display first 5 I didn't see any specification on how many to run.\n",
    "    ## chatgpt retaught me my printf syntax. I am more of a c++ guy, python is in one ear out the other.\n",
    "    print(f\"Samples are {sample_sizes[i]} Errors are {errors[i]}\")\n",
    "    \n",
    "    ## totally forgot about graphing\n",
    "plt.figure(figsize=(8,6))\n",
    "plt.plot(sample_sizes, errors)\n",
    "plt.xlabel(\"Samples\")\n",
    "plt.ylabel(\"Error Size\")\n",
    "plt.title(\"Monte Carlo Approximation Error for π\")\n",
    "plt.show()\n",
    "    \n",
    "        "
