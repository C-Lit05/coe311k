    "n = 2025\n",
    "remainders = []\n",
    "##yeah AI taught me .append I hope you can even see this notebook\n",
    "while n > 0:\n",
    "    remainder = n % 2\n",
    "    remainders.append(remainder)\n",
    "    n = n // 2\n",
    "\n",
    "# put it in reverse terry\n",
    "for r in reversed(remainders):\n",
    "    print(r, end=\"\")\n"
   ]
  }
